# Mirsal server configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# Path to the SQLite database file (bind-mounted host path in production, e.g. /app/data/db/mirsal.db)
DB_PATH=./data/db/mirsal.db

# Directory where uploaded file blobs are stored (bind-mounted host path in production)
STORAGE_DIR=./data/storage

# Random secret used to sign/validate opaque session cookies. Min 16 chars — generate with `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-random-secret-at-least-16-chars

# Random secret used for CSRF token validation. Min 16 chars — generate with `openssl rand -hex 32`.
CSRF_SECRET=change-me-to-a-random-secret-at-least-16-chars

# Public URL the app is served at (used to build absolute share links). Must be a valid URL.
PUBLIC_BASE_URL=https://project4.system.mow.gov.sy

# Argon2id memory cost in KiB (default 19456 = 19 MiB)
ARGON_MEMORY_KIB=19456

# Argon2id time cost / iterations (default 2)
ARGON_TIME=2

# Argon2id parallelism / lanes (default 1)
ARGON_PARALLELISM=1

# Max concurrent argon2id hashing operations allowed at once (semaphore limit, default 2)
ARGON_MAX_CONCURRENCY=2

# Server timezone — Damascus, to match host and match epoch-millis → local-time display conventions
TZ=Asia/Damascus
