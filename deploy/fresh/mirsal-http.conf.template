# Mirsal nginx vhost (public-IP VPS variant) — TEMPLATE.
# deploy/fresh/04-nginx-tls.sh substitutes __DOMAIN__ and installs this, then
# `certbot --nginx` rewrites it in place to add the `listen 443 ssl` server and
# an http->https redirect. nginx is the TLS edge here, so $remote_addr IS the
# real client and X-Forwarded-For is set clean (no upstream gateway to trust).
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Max upload size (app enforces 100 MB per file; headroom for multipart overhead).
    client_max_body_size 120M;

    # Streamed upload endpoint — do not buffer the whole body to disk first.
    location /api/nodes/upload {
        proxy_pass http://127.0.0.1:8084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;      # clean: only the real client
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_max_body_size 120M;
        proxy_read_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;      # clean: only the real client
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
